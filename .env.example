# Development: copy to .env.local. Self-hosting with Docker: copy to .env
# (see docs/SELF_HOSTING.md). Never commit real values.

# --- Required for self-hosting with docker-compose ---
POSTGRES_PASSWORD=
# Your site's domain, without https:// (Caddy gets its certificate).
APP_DOMAIN=formora.app
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=
# Your server's public IPv4 address; customers point their domains here.
SERVER_IPV4=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client (see docs/GOOGLE_AUTH_SETUP.md)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local testing only: shows "Sign in for testing" on /login, accepting any email with no
# password. Ignored unless APP_URL is http://localhost… so it can't run on your real site.
# Put your own email in ADMIN_EMAILS too, to test the admin pages.
DEV_LOGIN=

# PostgreSQL connection string. Required for accounts, saving, and publishing.
# docker-compose sets this for you. Migrations run on start and via `npm run db:migrate`.
DATABASE_URL=postgres://user:password@localhost:5432/formora
# TLS to the database: unset (same server), "require" (most managed providers), or "verify".
DATABASE_SSL=
DATABASE_POOL_MAX=10

# Optional: enables the AI assistant in the editor (https://platform.claude.com).
# Without it the editor falls back to local quick actions.
ANTHROPIC_API_KEY=

# The site's public URL (used for Stripe return links and to tell the site's own
# hostnames apart from customers' custom domains). Add extra hostnames to APP_HOSTS.
APP_URL=https://formora.example
APP_HOSTS=

# Optional: raises the GitHub import rate limit (a fine-grained token with no scopes is enough).
GITHUB_TOKEN=

# Custom domains (see docs/CUSTOM_DOMAINS.md). Connecting needs only SERVER_IPV4.
# Hostname customers CNAME subdomains to (defaults to APP_URL's host).
SITES_CNAME_TARGET=
# DNS servers used to verify customer domains (default 1.1.1.1,8.8.8.8).
DNS_RESOLVERS=
# Selling domains: Vercel is used only as the registrar (no Vercel hosting needed).
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
# Customer price = registrar price × (1 + markup) + fee, rounded up to a whole dollar.
DOMAIN_MARKUP_PERCENT=20
DOMAIN_SERVICE_FEE_CENTS=300

# Payments (Stripe): plans, AI credits and domains. In the Stripe dashboard add a
# webhook to https://<APP_DOMAIN>/api/webhooks/stripe for checkout.session.completed
# and checkout.session.async_payment_succeeded, and paste its signing secret here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Scheduled jobs (emails, renewals, monthly credits, auto-updates). The docker
# compose `cron` service calls /api/cron hourly with this secret. Make it long.
CRON_SECRET=

# AI: the ANTHROPIC_API_KEY above powers credits-based AI; customers can also add their own key.
# Hard stop for what the platform key may spend per day, in US dollars (default 25).
AI_DAILY_BUDGET_USD=25
# Encrypts customers' saved API keys. Defaults to AUTH_SECRET; set it separately if you can.
ENCRYPTION_KEY=

# Templates must be approved by an admin at /templates/review before customers see them.
# Set to false to show every template immediately.
TEMPLATES_REQUIRE_APPROVAL=true

# The owner's login is the superadmin, created with `npm run admin:create` (not set here).
# Optional: other people (comma-separated emails) who can use the admin pages: approve
# templates, moderate the community and write the Journal. They need a confirmed account.
ADMIN_EMAILS=
# Extra spam terms refused on the community board, comma-separated.
COMMUNITY_BLOCKED_TERMS=
# Shown in the site footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# Email from your company mailbox (Google Workspace, Zoho, Microsoft 365, your web host…):
# sign-up confirmations, password resets, reminders, receipts, support replies.
# Port 587, or 465 with SMTP_SECURE=true. SMTP_USER is usually the full mailbox address.
# Check them with "Send a test email" at /admin/email (superadmin).
# SMTP_FROM is the sender, e.g. "Formora <hello@yourdomain.com>"; SMTP_TO receives
# support requests and contact messages. Without SMTP, emails are only logged.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
