# Copy to .env.local for development and set the same values in your host's
# environment settings for production. Never commit real values.

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client (see docs/GOOGLE_AUTH_SETUP.md)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL connection string. Required for accounts, saving, and publishing.
# Tables are created automatically on first use.
DATABASE_URL=postgres://user:password@localhost:5432/formora

# Optional: enables the AI assistant in the editor (https://platform.claude.com).
# Without it the editor falls back to local quick actions.
ANTHROPIC_API_KEY=

# The site's public URL (used for Stripe return links and to tell the site's own
# hostnames apart from customers' custom domains). Add extra hostnames to APP_HOSTS.
APP_URL=https://formora.example
APP_HOSTS=

# Optional: raises the GitHub import rate limit (a fine-grained token with no scopes is enough).
GITHUB_TOKEN=

# Custom domains (see docs/CUSTOM_DOMAINS.md). Needs the site hosted on Vercel.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Customer price = registrar price × (1 + markup) + fee, rounded up to a whole dollar.
DOMAIN_MARKUP_PERCENT=20
DOMAIN_SERVICE_FEE_CENTS=300

# Payments (Stripe). Required for buying domains.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Contact form (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
