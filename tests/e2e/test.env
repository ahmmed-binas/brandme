# Environment for the end-to-end tests. Test values only, never real keys.
# Every outside service (GitHub, Vercel, Stripe, Anthropic, OpenAI) points at mock.mjs on :4010,
# and DNS lookups go to dns.mjs on :5353.
export DATABASE_URL=postgres://postgres:postgres@localhost:5432/formora
export AUTH_SECRET=test-secret-test-secret-test-secret-123
export AUTH_GOOGLE_ID=dummy AUTH_GOOGLE_SECRET=dummy
export AUTH_URL=http://localhost:3100 APP_URL=http://localhost:3100
export GITHUB_API_URL=http://localhost:4010
export VERCEL_API_URL=http://localhost:4010 VERCEL_API_TOKEN=test VERCEL_PROJECT_ID=prj_test
export STRIPE_API_URL=http://localhost:4010 STRIPE_SECRET_KEY=sk_test_123 STRIPE_WEBHOOK_SECRET=whsec_test
export SERVER_IPV4=127.0.0.1 DNS_RESOLVERS=127.0.0.1:5353
export ADMIN_EMAILS=mod@example.com
export ANTHROPIC_API_KEY=sk-ant-platform-test ANTHROPIC_BASE_URL=http://localhost:4010 AI_DAILY_BUDGET_USD=25
export OPENAI_BASE_URL=http://localhost:4010/openai/v1
export DEV_LOGIN=true CRON_SECRET=cron-secret-cron-secret-cron-secret
# Chromium for Playwright (leave unset to use Playwright's own download).
# export CHROMIUM_PATH=/path/to/chrome
export INVESTIGATOR_ALLOW_PRIVATE_FETCH=true   # lets tests read the mock feed on localhost; never set in production
